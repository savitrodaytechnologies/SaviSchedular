<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7" />
  </startup>

  <connectionStrings>
    <!-- Production DB — SchoolCalendar (holiday check) ke liye -->
    <add name="DefaultConnection"
         providerName="System.Data.SqlClient"
         connectionString="Data Source=rdsexpserver.ccmuwbvpbelg.ap-south-1.rds.amazonaws.com;Initial Catalog=savischoolprd002;User ID=rdsexproot;Password=9Char$tr;Integrated Security=False;Max Pool Size=25;Connect Timeout=60;" />
    <!-- SaviSchedular DB — Sabhi scheduler tables yahan hain -->
    <add name="SaviSchedularConnection"
         providerName="System.Data.SqlClient"
         connectionString="Data Source=rdsexpserver.ccmuwbvpbelg.ap-south-1.rds.amazonaws.com;Initial Catalog=SaviSchedular;User ID=rdsexproot;Password=9Char$tr;Integrated Security=False;Max Pool Size=25;Connect Timeout=60;" />
  </connectionStrings>

  <appSettings>
    <!-- Hangfire settings — baki sab settings ab DB (SchedulerGlobalConfig) mein hain -->
    <add key="HangfirePollIntervalSeconds" value="30" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.7" />
    <httpRuntime targetFramework="4.7" maxRequestLength="102400" executionTimeout="600" />
  </system.web>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*"
           type="System.Web.Handlers.TransferRequestHandler"
           preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
  </system.webServer>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" culture="neutral" publicKeyToken="30ad4fe6b2a6aeed" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="9.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Http" culture="neutral" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.3.0" newVersion="5.2.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Net.Http.Formatting" culture="neutral" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.3.0" newVersion="5.2.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Owin" culture="neutral" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.3.0" newVersion="4.2.3.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
